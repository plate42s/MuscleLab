# Front (local / build). Usa SOLO placeholders aquí; pega valores reales en tu .env local (no commitear).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Opcional (legacy anon JWT). Preferir publishable key.
# VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Solo Netlify / servidor (NUNCA con prefijo VITE_, NUNCA en el navegador):
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_KEY
