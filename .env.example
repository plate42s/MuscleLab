VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer the new publishable key (Settings → API Keys)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Optional legacy fallback (anon JWT starting with eyJ...)
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Solo en Netlify (nunca VITE_ / nunca en el navegador):
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_o_service_role_jwt

